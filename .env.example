# ==========================================
# KAMLESH FUL BHANDAR - ENVIRONMENT CONFIG
# ==========================================

# Backend Configuration
PORT=5000
DATABASE_URL="postgresql://user:password@localhost:5432/kamlesh_ful_bhandar?schema=public"
JWT_SECRET="your_long_random_jwt_secret_key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# Admin Authentication (Admin Key + Password)
# Configure ADMIN_KEY and ADMIN_PASSWORD_HASH (bcrypt hash) or ADMIN_PASSWORD
ADMIN_KEY="your_secure_admin_key_here"
ADMIN_PASSWORD_HASH="your_bcrypt_hash_here"
# ADMIN_PASSWORD="your_secure_password_here"

# Durable image storage required for uploads (Cloudinary; no local/serverless fallback)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Frontend Configuration
VITE_API_URL="http://localhost:5000/api"
